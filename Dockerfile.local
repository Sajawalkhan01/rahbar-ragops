# Offline variant of the ragops image. Used when pip/apt cannot reach the network (it happened during this
# assignment: downloads from pythonhosted.org and deb.debian.org stalled for 20+ minutes).
#
# Differences from Dockerfile:
#   * Python packages are COPIED from the tested WSL virtualenv instead of being installed from requirements.txt,
#     so the image runs exactly the versions the unit tests and the suites were run with.
#   * No tesseract/poppler: the cluster image cannot OCR scanned pages. Text-layer PDFs, Markdown, HTML and TXT are
#     unaffected. Anything that needs OCR will fail verification (quality check) instead of being indexed.
# Build it with scripts/build-image-local.sh, which assembles the context under ~/ragops-ctx.
FROM python:3.12.11-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app RAGOPS_ROOT=/app RAGOPS_DATA_DIR=/data HOME=/tmp
COPY site-packages /usr/local/lib/python3.12/site-packages
WORKDIR /app
COPY api/app /app/app
COPY indexer/pipeline /app/pipeline
COPY ragops /app/ragops
COPY config /app/config
COPY eval /app/eval
COPY experiments /app/experiments
RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin rahbar \
    && mkdir -p /data && chown 10001:10001 /data
USER 10001
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
